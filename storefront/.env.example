# Neon (or any Postgres) connection string. Use the *pooled* string from the
# Neon dashboard: Project > Connect > "Pooled connection".
# Leave unset to use the embedded local database in ./.data/pglite (dev only).
DATABASE_URL=

# Store sign-up invite codes (comma-separated). Each code can be used once.
INVITE_CODES=

# Neon Object Storage for product photos (Console > Connect > Storage).
# The bucket can stay private; the app serves photos at /media/<key>.
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=stores
